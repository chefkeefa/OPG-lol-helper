{
  "name": "rift-pulse",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "app": "concurrently -k -n vite,electron \"vite --port 5173 --strictPort --no-open\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "release": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1"
  },
  "description": "Rift Pulse — личный дашборд League of Legends",
  "main": "electron/main.cjs",
  "build": {
    "appId": "local.riftpulse.app",
    "productName": "Rift Pulse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/@tesseract.js-data/*/4.0.0/**",
      "!node_modules/tesseract.js-core/*.wasm.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "artifactName": "Rift-Pulse-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/tesseract.js/**",
      "node_modules/bmp-js/**",
      "node_modules/idb-keyval/**",
      "node_modules/is-url/**",
      "node_modules/node-fetch/**",
      "node_modules/whatwg-url/**",
      "node_modules/tr46/**",
      "node_modules/webidl-conversions/**",
      "node_modules/opencollective-postinstall/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/zlibjs/**",
      "node_modules/@tesseract.js-data/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "chefkeefa",
        "repo": "OPG-lol-helper",
        "releaseType": "release"
      }
    ]
  }
}
